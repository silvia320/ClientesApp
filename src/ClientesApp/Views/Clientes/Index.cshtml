@model IEnumerable<ClientesApp.Application.Dtos.ClienteDto>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Cédula</th><th>Cliente</th><th>Edad</th><th>Género</th><th>Correo</th><th>Teléfono</th>
                <th>Ciudad</th><th>Tipo</th><th>Activo</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Cedula</td>
                <td>@c.Nombres @c.Apellidos</td>
                <td>@c.Edad</td>
                <td>@c.GeneroNombre</td>
                <td>@c.Email</td>
                <td>@c.Telefono</td>
                <td>@c.CiudadNombre</td>
                <td>@c.TipoClienteNombre</td>
                <td>@(c.Activo ? "Sí" : "No")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>